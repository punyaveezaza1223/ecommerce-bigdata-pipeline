# eBay Browse API (Production)
# Search summaries are quota-efficient and contain the fields used downstream.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_SEARCH_QUERIES=women fashion,men fashion,sneakers,handbags,watches
EBAY_PAGE_SIZE=200
# Independent from EXTERNAL_MAX_PAGES so Rakuten's current scope is unchanged.
EBAY_MAX_PAGES=10
# Set true only for a small, deliberate enrichment/backfill run.
EBAY_FETCH_ITEM_DETAILS=false

# Rakuten Ichiba Item Search API supports a maximum of 30 results per page
# and 100 pages. This setting does not affect eBay.
RAKUTEN_PAGE_SIZE=30
RAKUTEN_MAX_PAGES=10

# Retained as a fallback for integrations that use the shared page limit.
EXTERNAL_MAX_PAGES=4

# StockX OAuth. Keep actual values only in the Git-ignored .env file.
STOCKX_API_KEY=
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
STOCKX_REDIRECT_URI=https://device-hon-stars-effort.trycloudflare.com/callback
# Normally leave these blank: stockx_callback.py stores refreshed tokens in
# STOCKX_TOKEN_FILE after a successful authorization.
STOCKX_ACCESS_TOKEN=
STOCKX_REFRESH_TOKEN=
STOCKX_TOKEN_FILE=.stockx-secrets/tokens.json
# Keep 127.0.0.1 for direct local Python. Docker's command overrides this
# to 0.0.0.0 while publishing only host 127.0.0.1:8000.
STOCKX_CALLBACK_HOST=127.0.0.1

# StockX Catalog Search. Keep the default scope modest: 5 queries x 2 pages
# x 25 products, with at least one second between API requests.
STOCKX_SEARCH_QUERIES=sneakers,t-shirt,jeans,handbag,jacket
STOCKX_PAGE_SIZE=25
STOCKX_MAX_PAGES=2
STOCKX_REQUEST_DELAY_SECONDS=1
